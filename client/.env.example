# KITOS 2.0 — client environment
#
# Copy to `.env.local` and fill in. Names and comments only: never commit a
# real value. `.env*` is git-ignored except this file.

# ── Public URL of this Next.js app ──────────────────────────────────────────
# Development: http://localhost:3004 (the port set in package.json).
# Production: the Vercel URL, e.g. https://kitos.vercel.app
NEXT_PUBLIC_LMS_URL=
NEXTAUTH_URL=

# Secret that signs and encrypts the NextAuth session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── KITOS API (server/) ─────────────────────────────────────────────────────
# Development: http://localhost:4000
# Production: the Render URL, e.g. https://kitos-api.onrender.com
# The browser calls this directly, so the API's CLIENT_ORIGIN must match
# NEXT_PUBLIC_LMS_URL.
NEXT_PUBLIC_API_URL=

# Socket.IO endpoint, normally the same origin as NEXT_PUBLIC_API_URL.
# The client only dials out when this is set, so leaving it unset is how you
# run the chat screens without a socket server — they fall back to local
# state and show the offline banner rather than logging a failed handshake
# on every render.
NEXT_PUBLIC_SOCKET_URL=

# ── Mock Service Worker ─────────────────────────────────────────────────────
# `enabled` starts MSW and serves the mock fixtures instead of the real API —
# useful for offline design checks only. Anything else (including unset)
# leaves it off. Must be `disabled` in production.
NEXT_PUBLIC_API_MOCKING=disabled

# ── Flutterwave (test mode, ADR-036) ────────────────────────────────────────
# Test public key, FLWPUBK_TEST-… . The secret key and the webhook hash belong
# to the server only and must never appear in a NEXT_PUBLIC_ variable: every
# one of those is compiled into the JavaScript the browser downloads.
#
# Unset, the checkout modal falls back to the hosted link the API returns, and
# in simulated mode it needs neither.
NEXT_PUBLIC_FLW_PUBLIC_KEY=

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# The provider only registers when both are set. Leave blank to sign in with
# credentials only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
