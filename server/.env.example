# KITOS 2.0 — API environment
#
# Copy to `server/.env` and fill in. Names and comments only: never commit a
# real value. `.env*` is git-ignored except this file.
#
# src/config/env.js validates all of this at boot and fails fast, naming the
# variable that is wrong.

# ── Runtime ─────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# 4000 locally; Render sets this itself (10000).
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# Local replica set from `npm run db:local`:
#   mongodb://127.0.0.1:27027/?directConnection=true
# Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=kitos

# ── Authentication ──────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
# Rotating this signs every existing session out.
JWT_SECRET=
# Matches the NextAuth session lifetime on the client (ADR-004).
JWT_EXPIRES_IN=24h

# ── CORS, links ─────────────────────────────────────────────────────────────
# The one browser origin allowed to call this API, and the base for links in
# outbound email. Development also allows http://localhost:3004 automatically.
CLIENT_ORIGIN=http://localhost:3004

# ── File storage ────────────────────────────────────────────────────────────
# `local` writes to disk — development only: Render's disk is wiped on every
# deploy (ADR-008). Production uses `cloudinary`, and then CLOUDINARY_URL is
# required or the API refuses to start.
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# ── Email ───────────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset in development: messages are written to
# server/.local/outbox/*.eml instead, so a password-reset link can be read off
# disk with no mail account.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kids In Tech <hello@kidsintech.school>"

# ── Paystack (Batch 3) ──────────────────────────────────────────────────────
# Test secret key, sk_test_… . Unset, /paystack/initiate returns a simulated
# reference so the client's four-step modal still works offline.
PAYSTACK_SECRET_KEY=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Sign-in attempts per 15 minutes, per IP and identifier. 10 is the policy
# (PRD §10) and the right value everywhere except an end-to-end run, which
# signs in as the same few demo accounts dozens of times and would lock itself
# out. Leave it alone outside CI.
LOGIN_RATE_LIMIT_MAX=10

# ── Demo seed guard ─────────────────────────────────────────────────────────
# `npm run seed` refuses to run against a production database unless
# ALLOW_DEMO_SEED=true and all three passwords are set (10+ characters each).
# Set these for the one seeding run, then remove them — never leave them on
# Render.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_FAMILY_PASSWORD=
